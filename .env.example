# Database
MONGO_USER=aethera
MONGO_PASS=<random-32-char-hex>
MONGO_PORT=27017

# JWT
JWT_SECRET=<random-64-char-hex>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=aethera

# App
NEXT_PUBLIC_APP_NAME=Aethera
NODE_ENV=production
APP_PORT=3000
# Host interface the panel binds to. 0.0.0.0 = published (default).
# Set to 127.0.0.1 to expose the panel on localhost only — e.g. when a local
# reverse proxy (Caddy/nginx) fronts it. The installer can set this via its
# exposure menu, or non-interactively with AETHERA_BIND=loopback.
# cloudflared-setup.sh also sets it to 127.0.0.1 to close the port on older Compose.
APP_BIND=0.0.0.0
# Public URL when behind a reverse proxy / Cloudflare tunnel (OPTIONAL)
APP_PUBLIC_URL=
APP_MEM_LIMIT=1g

# Docker orchestration
AETHERA_DATA_DIR=/home/.aethera/run
AETHERA_BACKUP_DIR=/home/.aethera/backup
AETHERA_WORLD_UPLOAD_DIR=/home/.aethera/world_upload
AETHERA_MINECRAFT_IMAGE=itzg/minecraft-server
MONGO_MEM_LIMIT=512m

# First-run admin (used by seed script OR setup wizard)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost.com
ADMIN_PASSWORD=admin

# Module system (OPTIONAL — leave empty to disable module registry)
# Hub base URL; panel appends /{version} for version-gated registry fetches.
# Legacy Paperview /shares/{id} URLs are still supported for back-compat.
MODULE_REGISTRY_URL=https://modules.getaethera.de/api/registry

# Version / update channel (OPTIONAL — auto-derived from the running version;
# set only to override, e.g. AETHERA_CHANNEL=stable forces stable on an edge build)
AETHERA_CHANNEL=
# Hub base URL; panel appends /{version} for version-gated registry fetches (B2/C1)
AETHERA_HUB_URL=https://modules.getaethera.de
# EXPERIMENTAL — leave false unless you know what you're doing; test on a
# non-critical host first. When true, the update endpoint pulls the new image and
# then auto-recreates the aethera-app panel container by launching a detached
# one-shot helper container (aethera-updater) from the NEW image. The helper
# outlives the old panel and does rename-based rollback (it restores the previous
# container if the new one fails to come up), so the panel is never left down.
# Requires the Docker socket to be mounted into the panel. When false (default),
# the endpoint only PULLS the image and you recreate aethera-app yourself, e.g.
# `docker compose up -d --pull always aethera-app`.
AETHERA_SELF_UPDATE=false

# CurseForge API (OPTIONAL — required for CurseForge pack support)
CURSEFORGE_API_KEY=

# Cloudflare Tunnel (OPTIONAL — managed by ./cloudflared-setup.sh)
# Token from Cloudflare Zero Trust > Networks > Tunnels. Only consumed when
# docker-compose.tunnel.yml is active.
TUNNEL_TOKEN=
